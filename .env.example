# ── PostgreSQL ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bussatest

# ── Puertos (el Hub los asigna automaticamente) ──
PUERTO_FRONTEND=3000
PUERTO_BACKEND=3001
PUERTO_POSTGRES=5432

# ── NestJS ──
JWT_SECRET=cambiar-por-secret-seguro
CORS_ORIGIN=http://localhost:${PUERTO_FRONTEND}

# ── Next.js (build arg + runtime) ──
NEXT_PUBLIC_API_URL=http://localhost:${PUERTO_BACKEND}

# ── Firebase Admin (opcional, produccion) ──
# Sin esto, el API corre en modo dev (el Bearer token IS the email).
# Para habilitarlo: montar el JSON de service account como volumen en
# docker-compose.prod.yml (servicio api) y descomentar la env var:
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
